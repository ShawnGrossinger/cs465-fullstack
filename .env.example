# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Required. At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional settings (defaults shown)
# NODE_ENV=development
# PORT=3000
# JWT_EXPIRES_IN=1h
# MONGODB_URI=mongodb://127.0.0.1/travlr        # or set DB_HOST=127.0.0.1
# CORS_ORIGINS=http://localhost:4200            # comma-separated list
# API_BASE_URL=http://localhost:3000/api        # where the customer site reads trips
# PBKDF2_ITERATIONS=220000                      # minimum 220000 outside tests (OWASP)
# LOGIN_RATE_LIMIT=10                           # failed logins per window per address
# LOGIN_RATE_WINDOW_MINUTES=15
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW_MINUTES=60

# Database integration tests (npm run test:db). Name must end in _test.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/travlr_test
