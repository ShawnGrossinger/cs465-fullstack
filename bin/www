#!/usr/bin/env node
'use strict';
/**
 * Server entry point: load and validate configuration, connect to MongoDB,
 * build the application, start listening, and shut down cleanly.
 */
const http = require('http');
const debug = require('debug')('travlr:server');

const { loadConfigFromEnvironment } = require('../app_api/config');
const { connect, disconnect } = require('../app_api/db/connection');
const { createMongoRepositories } = require('../app_api/repositories');
const { createApp } = require('../app');

async function main() {
    let config;
    try {
        config = loadConfigFromEnvironment();
    } catch (err) {
        // Refuse to start with missing or unsafe settings.
        console.error(err.message);
        process.exit(1);
    }

    await connect(config.db.uri);

    const app = createApp({ config, repositories: createMongoRepositories() });
    app.set('port', config.port);

    const server = http.createServer(app);
    server.on('error', (error) => onError(error, config.port));
    server.listen(config.port, () => {
        debug(`Listening on port ${config.port}`);
        console.log(`Travlr is running at http://localhost:${config.port}`);
    });

    // Graceful shutdown: stop accepting requests, let in-flight ones finish,
    // then close the database connection. (The original code defined a
    // shutdown function but never connected it to these signals.)
    let shuttingDown = false;
    const shutdown = (signal) => {
        if (shuttingDown) return;
        shuttingDown = true;
        console.log(`${signal} received, shutting down`);
        server.close(async () => {
            await disconnect();
            process.exit(0);
        });
        setTimeout(() => process.exit(1), 10000).unref(); // force exit if something hangs
    };
    process.on('SIGINT', () => shutdown('SIGINT'));
    process.on('SIGTERM', () => shutdown('SIGTERM'));
}

function onError(error, port) {
    if (error.syscall !== 'listen') throw error;
    switch (error.code) {
        case 'EACCES':
            console.error(`Port ${port} requires elevated privileges`);
            process.exit(1);
            break;
        case 'EADDRINUSE':
            console.error(`Port ${port} is already in use`);
            process.exit(1);
            break;
        default:
            throw error;
    }
}

main().catch((err) => {
    console.error(`Failed to start: ${err.message}`);
    process.exit(1);
});
